    ((-1 : ℚ), (-2 : ℤ), ([1, 0, 1, -1] : List ℤ)), ((-1/2 : ℚ), (-1 : ℤ), ([1, 0, 1, -1] : List ℤ)),
    ((3/2 : ℚ), (0 : ℤ), ([1, 0, 1, -1] : List ℤ)), ((-1 : ℚ), (-2 : ℤ), ([1, 0, -1, 1] : List ℤ)),
