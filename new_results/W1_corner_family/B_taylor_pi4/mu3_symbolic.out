mu_{0,n}  (1 monomials):
   [1] : -1/(n*(2*n - 1))
mu_{1,n}  (3 monomials):
   [1] : -1/(2*n**2)
   [g1] : 1/(n*(2*n - 1))
   [h1] : -1/(n*(2*n - 1))
mu_{2,n}  (9 monomials):
   [1] : -(4*n**2 - 2*n - 1)/(4*n**3*(2*n + 1))
   [z2] : 1/((2*n - 1)*(2*n + 1))
   [g2] : -1/(2*n*(2*n - 1))
   [g1] : 1/(2*n**2)
   [h2] : 1/(2*n*(2*n - 1)*(2*n + 1))
   [h1] : -1/(2*n**2)
   [g1^2] : -1/(2*n*(2*n - 1))
   [h1*g1] : 1/(n*(2*n - 1))
   [h1^2] : -1/(2*n*(2*n - 1))
mu_{3,n}  (22 monomials):
   [1] : -(16*n**5 - 12*n**3 + 4*n**2 + 5*n + 1)/(8*n**4*(n + 1)*(2*n + 1)**2)
   [z3] : -1/((2*n - 1)*(2*n + 1))
   [z2] : (5*n**2 + 5*n + 1)/(2*n*(n + 1)*(2*n + 1)**2)
   [g3] : 1/(3*n*(2*n - 1))
   [g2] : -1/(4*n**2)
   [g1] : (4*n**2 - 2*n - 1)/(4*n**3*(2*n + 1))
   [h3] : (n - 1)/(3*n*(2*n - 1)*(2*n + 1))
   [h2] : -(3*n + 1)*(2*n**2 - 1)/(4*n**2*(n + 1)*(2*n + 1)**2)
   [h1] : -(4*n**2 - 2*n - 1)/(4*n**3*(2*n + 1))
   [g1*z2] : -1/((2*n - 1)*(2*n + 1))
   [g1*g2] : 1/(2*n*(2*n - 1))
   [g1^2] : -1/(4*n**2)
   [h2*g1] : -1/(2*n*(2*n - 1)*(2*n + 1))
   [h1*z2] : 1/((2*n - 1)*(2*n + 1))
   [h1*g2] : -1/(2*n*(2*n - 1))
   [h1*g1] : 1/(2*n**2)
   [h1*h2] : 1/(2*n*(2*n - 1)*(2*n + 1))
   [h1^2] : -1/(4*n**2)
   [g1^3] : 1/(6*n*(2*n - 1))
   [h1*g1^2] : -1/(2*n*(2*n - 1))
   [h1^2*g1] : 1/(2*n*(2*n - 1))
   [h1^3] : -1/(6*n*(2*n - 1))
