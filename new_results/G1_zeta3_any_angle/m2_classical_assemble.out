UNIFORM CLASSICAL FORM:  M2 = z2*Phi(c) + sum  coef(c) * const * F(x=c)
   [   log2^3] * 1                      : c/3
   [ pi2*log2] * 1                      : -c/6
   [       z3] * 1                      : (8*c + 7)/4
   [        1] * Li2((1+x)/2)*l1m       : c - 1
   [        1] * Li2((1+x)/2)*l1p       : c + 1
   [        1] * Li2(-x)                : -1
   [        1] * Li2(-x)*l1m            : (c - 1)*(c + 1)/(2*c)
   [        1] * Li2(-x)*l1p            : (c - 1)*(c + 1)/(2*c)
   [        1] * Li2(x)                 : -1
   [        1] * Li2(x)*l1m             : -(c - 1)*(c + 1)/(2*c)
   [        1] * Li2(x)*l1p             : -(c - 1)*(c + 1)/(2*c)
   [        1] * Li3((1+x)/2)           : -2*c
   [        1] * Li3((1-x)/(1+x))       : 1 - c
   [        1] * Li3(-(1-x)/(1+x))      : 1 - c
   [        1] * Li3(-x)                : 1 - c
   [        1] * Li3(1-x)               : -(c - 1)/c
   [        1] * Li3(1/(1+x))           : -(c + 1)/c
   [        1] * Li3(2x/(1+x))          : -2*c
   [        1] * Li3(x)                 : c + 1
   [   log2^2] * l1m                    : (c - 1)/2
   [      pi2] * l1m                    : (c - 1)/(6*c)
   [     log2] * l1m*l1m                : 1 - c
   [        1] * l1m*l1m*l1p            : c - 1
   [     log2] * l1m*l1p                : c - 1
   [        1] * l1m*l1p*l1p            : 1 - c
   [   log2^2] * l1p                    : -(c - 1)/2
   [      pi2] * l1p                    : -(c + 1)/(6*c)
   [     log2] * l1p*l1p                : -c
   [        1] * l1p*l1p*l1p            : (4*c**2 - c + 1)/(6*c)
   [        1] * lx*l1m*l1m             : -(c - 1)*(c + 1)/(2*c)
   [        1] * lx*l1m*l1p             : c - 1
   [        1] * lx*l1p*l1p             : -(c**2 + 1)/(2*c)

Coefficient of zeta(3) in this uniform classical basis:  Z(c) = (8*c + 7)/4 = 2*c + 7/4
   pi_2: |classical formula - series M2| = 5.93e-322   Z(c) = 3.1642135623730950488
  2pi_3: |classical formula - series M2| = 5.2e-321   Z(c) = 2.75
   pi_3: |classical formula - series M2| = 5.69e-321   Z(c) = 3.4820508075688772935
  3pi_4: |classical formula - series M2| = 7.83e-321   Z(c) = 2.5153668647301795435
   pi_6: |classical formula - series M2| = 1.01e-320   Z(c) = 3.6818516525781365735
  5pi_6: |classical formula - series M2| = 1.28e-321   Z(c) = 2.2676380902050415247
   pi_4: |classical formula - series M2| = 1.26e-321   Z(c) = 3.5977590650225735123
 gen1p3: |classical formula - series M2| = 8.14e-321   Z(c) = 3.3421675970981116578
 gen2p0: |classical formula - series M2| = 1.22e-320   Z(c) = 2.8306046117362794348

Closed form at alpha = 2pi/3 (c = 1/2):  M2 = z2*Phi + ...
   Phi(c) = 1/2 - 3*log(3)/8
                             -1  *  -log(2)**2/2 + pi**2/12
                             -1  *  polylog(2, -1/2)
                            5/2  *  polylog(3, 1/2)
                            1/2  *  polylog(3, -1/2)
                             -4  *  polylog(3, 2/3)
                             -1  *  polylog(3, 3/4)
                            3/4  *  log((3/2)**(-log(2)**2/2 + pi**2/12))
                           -3/4  *  -log(2**(log(3/2)**2))
                            1/2  *  log(3/2)**3
                           -1/2  *  log(3/2)**2  *log2
                           -1/2  *  log(3/2)  *pi2
                            1/4  *  log(3/2)  *log2^2
                           11/4  *  1  *z3
                          -1/12  *  1  *pi2*log2
                            1/6  *  1  *log2^3
                            1/2  *  polylog(3, 1/3)
                            1/2  *  polylog(3, -1/3)
                           -3/4  *  -log(2)*polylog(2, -1/2)
                             -1  *  log((3/2)**(log(2)**2))
                           -1/6  *  -log(2)  *pi2
                            3/4  *  (-pi**2 + 6*log(2)**2)*log(2)/12
                            3/4  *  -log(2)**3
                           -1/2  *  -log(2)*polylog(2, 3/4)
                            1/2  *  log(2)**2  *log2
                           -1/2  *  -log(2**log(3/2))  *log2
                           -1/4  *  -log(2)  *log2^2
                           -3/4  *  log((3/2)**polylog(2, -1/2))
                            3/2  *  log((3/2)**polylog(2, 3/4))

Closed form at alpha = pi/3 (c = sqrt(3)/2):  M2 = z2*Phi + ...
   Phi(c) = -sqrt(3)*log(4*sqrt(3) + 7)/24 + 1/2
                             -1  *  polylog(2, sqrt(3)/2)
                             -1  *  polylog(2, -sqrt(3)/2)
                  sqrt(3)/2 + 1  *  polylog(3, sqrt(3)/2)
                  1 - sqrt(3)/2  *  polylog(3, -sqrt(3)/2)
               -2*sqrt(3)/3 - 1  *  polylog(3, 4 - 2*sqrt(3))
                       -sqrt(3)  *  polylog(3, sqrt(3)/4 + 1/2)
                       -sqrt(3)  *  polylog(3, -6 + 4*sqrt(3))
                     sqrt(3)/12  *  log(sqrt(3)/2 + 1)*polylog(2, sqrt(3)/2)
                  -7*sqrt(3)/12  *  (-log(2) + log(3)/2)*log(sqrt(3)/2 + 1)**2
             -1/6 + 4*sqrt(3)/9  *  log(sqrt(3)/2 + 1)**3
                     -sqrt(3)/2  *  log(sqrt(3)/2 + 1)**2  *log2
               -sqrt(3)/9 - 1/6  *  log(sqrt(3)/2 + 1)  *pi2
                1/2 - sqrt(3)/4  *  log(sqrt(3)/2 + 1)  *log2^2
                  sqrt(3) + 7/4  *  1  *z3
                    -sqrt(3)/12  *  1  *pi2*log2
                      sqrt(3)/6  *  1  *log2^3
               -1 + 2*sqrt(3)/3  *  polylog(3, 1 - sqrt(3)/2)
                  1 - sqrt(3)/2  *  polylog(3, 7 - 4*sqrt(3))
                  1 - sqrt(3)/2  *  polylog(3, -7 + 4*sqrt(3))
                    -sqrt(3)/12  *  log(1 - sqrt(3)/2)*polylog(2, -sqrt(3)/2)
                 -1 + sqrt(3)/2  *  (-log(2) + log(3)/2)*log(1 - sqrt(3)/2)*log(sqrt(3)/2 + 1)
                1/6 - sqrt(3)/9  *  log(1 - sqrt(3)/2)  *pi2
                     sqrt(3)/12  *  log(1 - sqrt(3)/2)*polylog(2, sqrt(3)/2)
                     sqrt(3)/12  *  (-log(2) + log(3)/2)*log(1 - sqrt(3)/2)**2
                 -1 + sqrt(3)/2  *  log(1 - sqrt(3)/2)*polylog(2, sqrt(3)/4 + 1/2)
                 -1 + sqrt(3)/2  *  log(1 - sqrt(3)/2)**2*log(sqrt(3)/2 + 1)
                  1 - sqrt(3)/2  *  log(1 - sqrt(3)/2)*log(sqrt(3)/2 + 1)**2
                  1 - sqrt(3)/2  *  log(1 - sqrt(3)/2)**2  *log2
                 -1 + sqrt(3)/2  *  log(1 - sqrt(3)/2)*log(sqrt(3)/2 + 1)  *log2
               -1/2 + sqrt(3)/4  *  log(1 - sqrt(3)/2)  *log2^2
                    -sqrt(3)/12  *  log(sqrt(3)/2 + 1)*polylog(2, -sqrt(3)/2)
                  sqrt(3)/2 + 1  *  log(sqrt(3)/2 + 1)*polylog(2, sqrt(3)/4 + 1/2)

Closed form at alpha = pi/2 (c = sqrt(2)/2):  M2 = z2*Phi + ...
   Phi(c) = -sqrt(2)*log(2*sqrt(2) + 3)/8 + 1/2
                             -1  *  polylog(2, sqrt(2)/2)
                             -1  *  polylog(2, -sqrt(2)/2)
                  sqrt(2)/2 + 1  *  polylog(3, sqrt(2)/2)
                  1 - sqrt(2)/2  *  polylog(3, -sqrt(2)/2)
                   -sqrt(2) - 1  *  polylog(3, 2 - sqrt(2))
                       -sqrt(2)  *  polylog(3, sqrt(2)/4 + 1/2)
                       -sqrt(2)  *  polylog(3, -2 + 2*sqrt(2))
                      sqrt(2)/4  *  log(sqrt(2)/2 + 1)*polylog(2, sqrt(2)/2)
                   -3*sqrt(2)/4  *  -log(2)*log(sqrt(2)/2 + 1)**2/2
               -1/6 + sqrt(2)/2  *  log(sqrt(2)/2 + 1)**3
                     -sqrt(2)/2  *  log(sqrt(2)/2 + 1)**2  *log2
               -sqrt(2)/6 - 1/6  *  log(sqrt(2)/2 + 1)  *pi2
                1/2 - sqrt(2)/4  *  log(sqrt(2)/2 + 1)  *log2^2
                  sqrt(2) + 7/4  *  1  *z3
                    -sqrt(2)/12  *  1  *pi2*log2
                      sqrt(2)/6  *  1  *log2^3
                   -1 + sqrt(2)  *  polylog(3, 1 - sqrt(2)/2)
                  1 - sqrt(2)/2  *  polylog(3, 3 - 2*sqrt(2))
                  1 - sqrt(2)/2  *  polylog(3, -3 + 2*sqrt(2))
                     -sqrt(2)/4  *  log(1 - sqrt(2)/2)*polylog(2, -sqrt(2)/2)
                 -1 + sqrt(2)/2  *  -log(2)*log(1 - sqrt(2)/2)*log(sqrt(2)/2 + 1)/2
                1/6 - sqrt(2)/6  *  log(1 - sqrt(2)/2)  *pi2
                      sqrt(2)/4  *  log(1 - sqrt(2)/2)*polylog(2, sqrt(2)/2)
                      sqrt(2)/4  *  -log(2)*log(1 - sqrt(2)/2)**2/2
                 -1 + sqrt(2)/2  *  log(1 - sqrt(2)/2)*polylog(2, sqrt(2)/4 + 1/2)
                 -1 + sqrt(2)/2  *  log(1 - sqrt(2)/2)**2*log(sqrt(2)/2 + 1)
                  1 - sqrt(2)/2  *  log(1 - sqrt(2)/2)*log(sqrt(2)/2 + 1)**2
                  1 - sqrt(2)/2  *  log(1 - sqrt(2)/2)**2  *log2
                 -1 + sqrt(2)/2  *  log(1 - sqrt(2)/2)*log(sqrt(2)/2 + 1)  *log2
               -1/2 + sqrt(2)/4  *  log(1 - sqrt(2)/2)  *log2^2
                     -sqrt(2)/4  *  log(sqrt(2)/2 + 1)*polylog(2, -sqrt(2)/2)
                  sqrt(2)/2 + 1  *  log(sqrt(2)/2 + 1)*polylog(2, sqrt(2)/4 + 1/2)
