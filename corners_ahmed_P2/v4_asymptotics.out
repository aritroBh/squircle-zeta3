Symbolic coefficients of n^-k in L_theta(n) - [1 + c + 2z (e^a1/n)^(1/(n-1))]   (Lg = log n, g_m = gamma_m):
  Q2 = 2*a2*z - g2
  Q3 = -2*Lg*a2*z + 2*a1*a2*z + 4*a2*z + 2*a3*z - 2*g2 - g3/2
  Q4 = Lg**2*a2*z + Lg*(-2*a1*a2*z - 6*a2*z - 2*a3*z) + a1**2*a2*z + 6*a1*a2*z + 2*a1*a3*z + a2**2*z + 6*a2*z + 6*a3*z + 2*a4*z - 4*g2 - 3*g3/4 - g4/3

  gamma_m in terms of z = sin^2(theta/2): {2: -2*z*(z - 1), 3: -2*z*(z - 1)*(2*z - 1), 4: -2*z*(z - 1)*(5*z**2 - 5*z + 1), 5: -2*z*(z - 1)*(2*z - 1)*(7*z**2 - 7*z + 1)}

  Q2 = 2*z*(a2 + z - 1)
  Q3 = z*(-2*Lg*a2 + 2*a1*a2 + 4*a2 + 2*a3 + 2*z**2 + z - 3)
  Q4 = Lg**2*a2*z + Lg*(-2*a1*a2*z - 6*a2*z - 2*a3*z) + a1**2*a2*z + 6*a1*a2*z + 2*a1*a3*z + a2**2*z + 6*a2*z + 6*a3*z + 2*a4*z + 10*z**4/3 - 11*z**3/3 + 15*z**2/2 - 43*z/6

